# ── AI-hjälpen ────────────────────────────────────────────────────────────────
# Utan nyckel: i `npm run dev` körs AI-hjälpen i testläge (förskrivna svar, ingen kostnad).
# I produktion döljs AI-hjälpen helt om nyckeln saknas och AI_MODEL inte är "mock".
# Skapa nyckel på https://platform.claude.com (sätt en utgiftsgräns under Billing).
ANTHROPIC_API_KEY=

# Vilken modell som används som standard:
#   mock               testläge utan AI (fungerar utan nyckel)
#   claude-haiku-5-5   billigast – bra för att testa
#   claude-sonnet-5-5  standard om inget anges
#   claude-opus-5-5    mest kapabel, dyrast
AI_MODEL=claude-haiku-5-5

# 1 = visa modellväljare i AI-hjälpen för att jämföra modeller (alltid på i `npm run dev`).
# Slå på i en preview-miljö när Marcus ska jämföra – aldrig i skarp drift.
AI_MODEL_SWITCHER=

# Publik adress (används för metadata/OG-länkar). Exempel: https://hemuppgifter.optimental.se
NEXT_PUBLIC_SITE_URL=http://localhost:3000
