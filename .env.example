# AI-hjälpen ("Fråga AI") aktiveras bara om nyckeln finns.
# Utan nyckel fungerar allt annat – formulär, exempel, PDF och skattningar.
# Skapa nyckel på https://console.anthropic.com (lägg in i Vercel → Settings → Environment Variables).
ANTHROPIC_API_KEY=

# Publik adress (används för metadata/OG-länkar). Exempel: https://hemuppgifter.optimental.se
NEXT_PUBLIC_SITE_URL=http://localhost:3000
